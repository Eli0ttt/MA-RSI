# Copy to env/experiment.env. Set OPENAI_API_KEY locally and chmod 600.
# Shared research settings for all six tasks.
OPENAI_API_KEY=''
OPENAI_BASE_URL='http://183.230.173.202:36789/v1'
META_MODEL='deepseek-v4-flash-s1'
MODEL_POOL='deepseek-v4-flash-s1,deepseek-v4-flash-s2,GLM-5.3-Flash,GLM-5.3-W4A8'
MA_RSI_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RSI_TASKS_ROOT="$MA_RSI_ROOT/rsi_exam_tasks"
HARBOR_BIN="$HOME/.local/share/uv/tools/harbor/bin/harbor"
MAX_VALID_VERSIONS=6
MODEL_REQUEST_TIMEOUT_SEC=180
MODEL_REQUEST_MAX_RETRIES=2
EVOMAS_PER_MODEL_CONCURRENCY=2
EVOMAS_MODEL_LOCK_DIR='/tmp/evomas_model_slots'
