# Copy to env/experiment.env, supply the key locally, chmod 600.
OPENAI_API_KEY=''
OPENAI_BASE_URL='http://183.230.173.202:36789/v1'
META_MODEL='deepseek-v4-flash-s1'
MODEL_POOL='deepseek-v4-flash-s1,deepseek-v4-flash-s2,GLM-5.3-Flash,GLM-5.3-W4A8'
BBO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RSI_TASKS_ROOT="$BBO_ROOT/rsi_exam_tasks"
HARBOR_BIN="$HOME/.local/share/uv/tools/harbor/bin/harbor"
BBO_EVAL_CONTAINER='bbo-evomas-visible-wenxinyi'
SUBSET_MAX_VERSIONS=6
MUTATION_PROBABILITY=0.7
POOL_PROMOTION_MODE=auto
PARENT_CONFIG_POLICY=exact
PARENT_POOL_POLICY=seeds
PARENT_POOL_DIR="$BBO_ROOT/repro/pool"
KNOWLEDGE_READ_MODE=shared
BBO_OPENAI_TIMEOUT=180
BBO_OPENAI_MAX_RETRIES=2
EVOMAS_PER_MODEL_CONCURRENCY=2
EVOMAS_MODEL_LOCK_DIR='/tmp/evomas_model_slots'
